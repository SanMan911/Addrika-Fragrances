{
  "expo": {
    "name": "Addrika",
    "slug": "addrika-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "addrika",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1e3a52"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.centraders.addrika"
    },
    "android": {
      "package": "com.centraders.addrika"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "apiBaseUrl": ""
    }
  }
}

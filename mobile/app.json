{
  "expo": {
    "name": "Aarohmm",
    "slug": "addrika-mobile",
    "version": "0.3.0",
    "orientation": "portrait",
    "scheme": "aaroviah",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e3a52"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.centraders.aaroviah"
    },
    "android": {
      "package": "com.centraders.aaroviah",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1e3a52"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Aarohmm needs access to your photos so you can attach pictures to a grievance."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/app-preview"
    },
    "extra": {
      "supabaseUrl": "https://qzzwaqwgzvrdecheunpn.supabase.co",
      "supabaseAnonKey": "sb_publishable_dUgl8KWxj4dArmssOQZpFw_9vd2CtR4",
      "apiBaseUrl": "https://addrika-fragrances-backend.onrender.com",
      "webUrl": "https://www.centraders.com",
      "mobileBrandName": "Aarohmm",
      "mobileBrandTagline": "Sacred Luxury in Every Scent",
      "eas": {
        "projectId": "f152117c-57fb-4506-a44a-7c53d1043dd3"
      }
    }
  }
}

{
  "expo": {
    "name": "Aaroviah",
    "slug": "aaroviah-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "addrika",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e3a52"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.centraders.addrika"
    },
    "android": {
      "package": "com.centraders.addrika",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1e3a52"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "apiBaseUrl": "",
      "webUrl": "https://www.centraders.com",
      "mobileBrandName": "Aaroviah",
      "mobileBrandTagline": "Sacred Luxury in Every Scent"
    }
  }
}
